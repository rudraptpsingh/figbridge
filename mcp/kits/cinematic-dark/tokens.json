{
  "$meta": {
    "style": "cinematic-dark",
    "version": "1.0.0",
    "description": "Deep near-black canvases punctuated by intentional, high-contrast light. Atmospheric depth via a lifted elevation ladder, glow shadows, gradient accent beams, and glass surfaces. The house style of dev tools, AI platforms, and ShotSelect.",
    "signature": [
      "near-black canvas (#0a0a0a / photo-stage #070708, never pure #000)",
      "lifted elevation ladder (--el-0..3)",
      "glow shadows (0 0 40px rgba)",
      "gradient accent borders / ambient beams",
      "generous letter-spacing on headers",
      "glass surfaces (backdrop-filter blur)"
    ],
    "fingerprint": { "gradients": "high", "glowShadows": "high", "backdropBlur": "present", "uppercaseLabels": "present" }
  },

  "color": {
    "app-bg":        { "value": "#0a0a0a", "comment": "window background" },
    "photo-stage":   { "value": "#070708", "comment": "near-black media stage — intentional, pro-standard" },
    "el-0":          { "value": "#141416", "comment": "base — sidebars, structural frames" },
    "el-1":          { "value": "#1b1b1d", "comment": "canvas — content panels, toolbar fill" },
    "el-2":          { "value": "#242427", "comment": "in-line — cards, hovered menus" },
    "el-3":          { "value": "#2c2c30", "comment": "floating — popovers, sheets, palette" },
    "surface-glass": { "value": "rgba(20,20,22,0.72)", "comment": "glass chrome over content" },
    "text-primary":   { "value": "#fafafa" },
    "text-secondary": { "value": "#a3a3a3" },
    "text-tertiary":  { "value": "#8a8a8a", "comment": "AA (~4.6:1 on el-2)" },
    "accent-primary":       { "value": "#ffffff", "comment": "primary action = white on dark" },
    "accent-iris":          { "value": "#7c6cfc", "comment": "signature glow accent" },
    "accent-iris-bright":   { "value": "#9d90ff" },
    "accent-success":       { "value": "#22c55e" },
    "accent-success-muted": { "value": "#16a34a" },
    "accent-danger":        { "value": "#ef4444" },
    "accent-danger-muted":  { "value": "#dc2626" },
    "accent-warning":       { "value": "#f59e0b" },
    "accent-info":          { "value": "#3b82f6" },
    "border-subtle":  { "value": "rgba(255,255,255,0.06)" },
    "border-default": { "value": "rgba(255,255,255,0.10)" },
    "el-stroke":      { "value": "rgba(255,255,255,0.08)" },
    "focus-ring":     { "value": "rgba(124,108,252,0.65)", "comment": "iris focus glow" }
  },

  "radius": {
    "xs": { "value": "6px" }, "sm": { "value": "8px" }, "md": { "value": "12px" },
    "lg": { "value": "16px" }, "xl": { "value": "20px" }, "pill": { "value": "999px" }
  },

  "space": {
    "1": { "value": "4px" }, "2": { "value": "8px" }, "3": { "value": "12px" },
    "4": { "value": "16px" }, "5": { "value": "20px" }, "6": { "value": "24px" },
    "8": { "value": "32px" }, "10": { "value": "40px" }, "12": { "value": "48px" }
  },

  "type": {
    "font-display": { "value": "-apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"Helvetica Neue\", sans-serif", "comment": "swappable per project" },
    "font-body":    { "value": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Helvetica Neue\", Arial, sans-serif" },
    "font-mono":    { "value": "\"SF Mono\", \"JetBrains Mono\", \"Fira Code\", ui-monospace, monospace" },
    "display":     { "size": "40px", "weight": "700", "letterSpacing": "-0.02em", "lineHeight": "1.05" },
    "large-title": { "size": "26px", "weight": "700", "letterSpacing": "-0.02em", "lineHeight": "1.15" },
    "title":       { "size": "17px", "weight": "600", "letterSpacing": "-0.01em", "lineHeight": "1.3" },
    "body":        { "size": "14px", "weight": "400", "letterSpacing": "0",       "lineHeight": "1.5" },
    "label-tiny":  { "size": "11px", "weight": "600", "letterSpacing": "0.07em",  "lineHeight": "1.2", "transform": "uppercase" },
    "mono":        { "size": "12px", "weight": "500", "letterSpacing": "0",       "lineHeight": "1.4", "fontFeature": "tabular-nums" }
  },

  "shadow": {
    "el-1":         { "value": "0 1px 3px rgba(0,0,0,.3), 0 1px 2px rgba(0,0,0,.2)" },
    "el-2":         { "value": "0 8px 24px rgba(0,0,0,.5)" },
    "el-3":         { "value": "0 30px 80px -10px rgba(0,0,0,.7)" },
    "glow-iris":    { "value": "0 0 40px rgba(124,108,252,.45)", "comment": "cinematic self-illumination" },
    "glow-success": { "value": "0 0 32px rgba(34,197,94,.35)" },
    "glow-danger":  { "value": "0 0 32px rgba(239,68,68,.35)" }
  },

  "gradient": {
    "iris-beam":    { "value": "linear-gradient(135deg, rgba(124,108,252,.9), rgba(59,130,246,.6))", "comment": "accent border / beam" },
    "stage-fade":   { "value": "linear-gradient(180deg, #14171c 0%, #0a0a0b 55%, #070708 100%)" },
    "surface-sheen":{ "value": "linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,0))" }
  },

  "motion": {
    "fast": { "value": "120ms" }, "base": { "value": "180ms" }, "slow": { "value": "320ms" },
    "ease": { "value": "cubic-bezier(.2,.8,.2,1)" }
  }
}
